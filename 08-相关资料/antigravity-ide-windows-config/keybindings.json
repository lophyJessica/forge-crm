[
    // 1. 从源码切换到当前标签页预览
    {
        "key": "ctrl+q",
        "command": "markdown.showPreview",
        "when": "editorTextFocus && editorLangId == 'markdown'"
    },
    // 2. 从预览模式切回源码
    {
        "key": "ctrl+q",
        "command": "workbench.action.reopenTextEditor",
        "when": "activeEditorId == 'workbench.editors.markdown-preview' || !editorTextFocus"
    }
]
